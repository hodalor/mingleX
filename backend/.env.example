PORT=4000
NODE_ENV=development
MONGODB_URI=mongodb+srv://USER:PASSWORD@CLUSTER.mongodb.net/minglex?retryWrites=true&w=majority
JWT_SECRET=replace-with-a-random-string-at-least-32-chars
JWT_EXPIRES_IN=7d
# Comma-separated origins are allowed. On Cloud Run include the Netlify sites.
CLIENT_WEB_ORIGIN=http://localhost:5173,https://YOUR-WEB.netlify.app
CLIENT_ADMIN_ORIGIN=http://localhost:5174,https://YOUR-ADMIN.netlify.app
ADMIN_EMAIL=admin@minglex.app
ADMIN_PASSWORD=change-this-admin-password
ADMIN_NAME=mingleX Admin
GOOGLE_CLIENT_ID=
APPLE_CLIENT_ID=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM=
# Firebase replaces Twilio for phone sign-in and sends match and message alerts. Leave blank until the keys are ready.
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=
# Photos move to this bucket when the three values below are set. Until then they stay in backend/uploads.
GCS_BUCKET=
GCS_PROJECT_ID=
GCS_CLIENT_EMAIL=
GCS_PRIVATE_KEY=
PAYSTACK_SECRET_KEY=
PAYSTACK_PUBLIC_KEY=
PAYSTACK_CURRENCY=GHS
PAYSTACK_AMOUNT=250000
